{
  "name": "react-native-country-state-city",
  "version": "1.0.9",
  "description": "A JavaScript and TypeScript library providing countries, states, and cities data for React, React Native, and other JavaScript applications.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./data": {
      "types": "./lib/utils/data.d.ts",
      "default": "./lib/utils/data.js"
    }
  },
  "files": [
    "lib/"
  ],
  "scripts": {
    "build": "node --max-old-space-size=8192 ./node_modules/typescript/bin/tsc",
    "prepublishOnly": "npm run build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
     "country",
    "state",
    "city",
    "countries",
    "states",
    "cities",
    "location",
    "geography",
    "reactjs",
    "react-native",
    "typescript"
  ],
  "author": "syedgambalshah",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syedghazi421/react-native-country-state-city.git"
  },
  "bugs": {
    "url": "https://github.com/syedghazi421/react-native-country-state-city/issues"
  },
  "homepage": "https://github.com/syedghazi421/react-native-country-state-city#readme",
  "type": "commonjs",
  "devDependencies": {
    "@types/react": "^19.2.17",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-native": ">=0.60.0"
  },
  "dependencies": {
   
  }
}
